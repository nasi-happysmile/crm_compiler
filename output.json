{
  "intent": {
    "raw_prompt": "Build a CRM with login, contacts, dashboard, role-based access, and premium plan with payments. Admins can see analytics.",
    "parsed_features": [
      "authentication",
      "contact_management",
      "dashboard",
      "role_based_access_control",
      "premium_plan",
      "payment_processing",
      "analytics_for_admins"
    ],
    "app_type": "CRM (Customer Relationship Management)",
    "target_users": [
      "admin",
      "manager",
      "sales_rep",
      "viewer"
    ],
    "monetization": "freemium_with_premium_subscription",
    "confidence": 0.94
  },
  "system_design": {
    "architecture": "monolith_with_modular_services",
    "entities": [
      "User",
      "Contact",
      "Deal",
      "Activity",
      "Plan",
      "Subscription",
      "Payment",
      "AnalyticsEvent"
    ],
    "flows": {
      "auth_flow": [
        "user_visits_login",
        "submit_credentials",
        "verify_password_hash",
        "issue_jwt",
        "store_refresh_token",
        "redirect_to_dashboard"
      ],
      "contact_flow": [
        "user_navigates_contacts",
        "fetch_contacts_by_role",
        "render_list",
        "crud_operations",
        "sync_activity_log"
      ],
      "payment_flow": [
        "user_selects_premium",
        "redirect_to_stripe_checkout",
        "webhook_payment_success",
        "update_subscription",
        "unlock_premium_features"
      ],
      "analytics_flow": [
        "admin_visits_dashboard",
        "query_analytics_events",
        "aggregate_by_dimension",
        "render_charts"
      ]
    },
    "roles": {
      "admin": [
        "read:all",
        "write:all",
        "delete:all",
        "view:analytics",
        "manage:users",
        "manage:plans"
      ],
      "manager": [
        "read:contacts",
        "write:contacts",
        "read:deals",
        "write:deals",
        "view:team_analytics"
      ],
      "sales_rep": [
        "read:own_contacts",
        "write:own_contacts",
        "read:own_deals",
        "write:own_deals"
      ],
      "viewer": [
        "read:own_contacts",
        "read:own_deals"
      ]
    },
    "services": {
      "auth_service": {
        "type": "internal",
        "tech": "JWT + bcrypt"
      },
      "payment_service": {
        "type": "external",
        "provider": "Stripe",
        "integration": "webhooks + Stripe Checkout"
      },
      "email_service": {
        "type": "external",
        "provider": "SendGrid",
        "use": "notifications + verification"
      },
      "analytics_service": {
        "type": "internal",
        "engine": "event_sourcing + materialized_views"
      }
    }
  },
  "schemas": {
    "ui": {
      "pages": [
        {
          "id": "login",
          "route": "/login",
          "access": "public",
          "components": [
            {
              "type": "form",
              "fields": [
                {
                  "name": "email",
                  "type": "email",
                  "required": true
                },
                {
                  "name": "password",
                  "type": "password",
                  "required": true
                }
              ]
            },
            {
              "type": "button",
              "label": "Sign in",
              "action": "POST /api/auth/login"
            },
            {
              "type": "link",
              "label": "Forgot password",
              "href": "/forgot-password"
            }
          ]
        },
        {
          "id": "dashboard",
          "route": "/dashboard",
          "access": "authenticated",
          "components": [
            {
              "type": "metric_card",
              "label": "Total Contacts",
              "data_source": "GET /api/contacts/count"
            },
            {
              "type": "metric_card",
              "label": "Open Deals",
              "data_source": "GET /api/deals/count?status=open"
            },
            {
              "type": "metric_card",
              "label": "Revenue MTD",
              "data_source": "GET /api/analytics/revenue",
              "role_guard": "admin,manager"
            },
            {
              "type": "chart",
              "chart_type": "line",
              "label": "Activity Over Time",
              "data_source": "GET /api/analytics/activity",
              "role_guard": "admin"
            },
            {
              "type": "chart",
              "chart_type": "bar",
              "label": "Deals by Stage",
              "data_source": "GET /api/deals/by-stage"
            }
          ]
        },
        {
          "id": "contacts",
          "route": "/contacts",
          "access": "authenticated",
          "components": [
            {
              "type": "data_table",
              "columns": [
                "name",
                "email",
                "phone",
                "company",
                "owner",
                "status",
                "created_at"
              ],
              "actions": [
                "create",
                "edit",
                "delete",
                "assign"
              ],
              "data_source": "GET /api/contacts",
              "pagination": {
                "page_size": 25,
                "cursor_based": true
              }
            },
            {
              "type": "search_bar",
              "placeholder": "Search contacts..."
            },
            {
              "type": "filter_panel",
              "filters": [
                "status",
                "owner",
                "company",
                "date_range"
              ]
            }
          ]
        },
        {
          "id": "analytics",
          "route": "/analytics",
          "access": "admin_only",
          "role_guard": "admin",
          "components": [
            {
              "type": "chart",
              "chart_type": "funnel",
              "label": "Deal Conversion Funnel",
              "data_source": "GET /api/analytics/funnel"
            },
            {
              "type": "chart",
              "chart_type": "heatmap",
              "label": "Activity Heatmap",
              "data_source": "GET /api/analytics/heatmap"
            },
            {
              "type": "chart",
              "chart_type": "pie",
              "label": "Contacts by Source",
              "data_source": "GET /api/analytics/contact-sources"
            },
            {
              "type": "metric_card",
              "label": "MRR",
              "data_source": "GET /api/analytics/mrr"
            },
            {
              "type": "export_button",
              "formats": [
                "csv",
                "pdf"
              ],
              "endpoint": "GET /api/analytics/export"
            }
          ]
        },
        {
          "id": "billing",
          "route": "/billing",
          "access": "authenticated",
          "components": [
            {
              "type": "plan_card",
              "plans": [
                "free",
                "premium"
              ],
              "current_plan_source": "GET /api/subscriptions/current"
            },
            {
              "type": "button",
              "label": "Upgrade to Premium",
              "action": "POST /api/subscriptions/checkout",
              "plan_guard": "free_only"
            },
            {
              "type": "invoice_table",
              "data_source": "GET /api/subscriptions/invoices"
            }
          ]
        }
      ]
    },
    "api": {
      "base_url": "/api/v1",
      "auth_header": "Authorization: Bearer <jwt>",
      "endpoints": [
        {
          "method": "POST",
          "path": "/auth/login",
          "body": {
            "email": "string",
            "password": "string"
          },
          "response": {
            "token": "string",
            "refresh_token": "string",
            "user": "UserObject"
          },
          "auth_required": false
        },
        {
          "method": "POST",
          "path": "/auth/logout",
          "auth_required": true,
          "response": {
            "success": "boolean"
          }
        },
        {
          "method": "POST",
          "path": "/auth/refresh",
          "body": {
            "refresh_token": "string"
          },
          "response": {
            "token": "string"
          },
          "auth_required": false
        },
        {
          "method": "GET",
          "path": "/contacts",
          "query": {
            "page": "int",
            "limit": "int",
            "search": "string",
            "status": "string"
          },
          "response": {
            "data": "Contact[]",
            "total": "int",
            "cursor": "string"
          },
          "auth_required": true,
          "role_guard": "any"
        },
        {
          "method": "POST",
          "path": "/contacts",
          "body": {
            "name": "string",
            "email": "string",
            "phone": "string?",
            "company": "string?",
            "owner_id": "uuid"
          },
          "response": {
            "data": "Contact"
          },
          "auth_required": true,
          "role_guard": "admin,manager,sales_rep"
        },
        {
          "method": "PUT",
          "path": "/contacts/:id",
          "body": "Partial<Contact>",
          "response": {
            "data": "Contact"
          },
          "auth_required": true,
          "role_guard": "admin,manager,sales_rep",
          "ownership_check": "sales_rep"
        },
        {
          "method": "DELETE",
          "path": "/contacts/:id",
          "auth_required": true,
          "role_guard": "admin,manager",
          "response": {
            "success": "boolean"
          }
        },
        {
          "method": "GET",
          "path": "/deals",
          "query": {
            "stage": "string",
            "owner_id": "uuid"
          },
          "response": {
            "data": "Deal[]"
          },
          "auth_required": true,
          "role_guard": "any"
        },
        {
          "method": "GET",
          "path": "/analytics/overview",
          "response": {
            "contacts_total": "int",
            "deals_open": "int",
            "mrr": "float",
            "activity_events_7d": "int"
          },
          "auth_required": true,
          "role_guard": "admin,manager"
        },
        {
          "method": "GET",
          "path": "/analytics/funnel",
          "response": {
            "stages": "FunnelStage[]"
          },
          "auth_required": true,
          "role_guard": "admin"
        },
        {
          "method": "GET",
          "path": "/analytics/mrr",
          "response": {
            "mrr": "float",
            "history": "MRRPoint[]"
          },
          "auth_required": true,
          "role_guard": "admin"
        },
        {
          "method": "POST",
          "path": "/subscriptions/checkout",
          "body": {
            "plan_id": "string"
          },
          "response": {
            "checkout_url": "string"
          },
          "auth_required": true
        },
        {
          "method": "GET",
          "path": "/subscriptions/current",
          "response": {
            "plan": "string",
            "status": "string",
            "renews_at": "datetime"
          },
          "auth_required": true
        },
        {
          "method": "POST",
          "path": "/webhooks/stripe",
          "body": "StripeEvent",
          "auth_required": false,
          "secret_header": "Stripe-Signature"
        }
      ]
    },
    "db": {
      "engine": "PostgreSQL 15",
      "tables": {
        "users": {
          "columns": {
            "id": "UUID PK DEFAULT gen_random_uuid()",
            "email": "VARCHAR(255) UNIQUE NOT NULL",
            "password_hash": "TEXT NOT NULL",
            "role": "ENUM('admin','manager','sales_rep','viewer') NOT NULL DEFAULT 'viewer'",
            "plan": "ENUM('free','premium') NOT NULL DEFAULT 'free'",
            "created_at": "TIMESTAMPTZ DEFAULT now()",
            "updated_at": "TIMESTAMPTZ DEFAULT now()"
          },
          "indexes": [
            "email"
          ]
        },
        "contacts": {
          "columns": {
            "id": "UUID PK DEFAULT gen_random_uuid()",
            "owner_id": "UUID FK→users.id",
            "name": "VARCHAR(255) NOT NULL",
            "email": "VARCHAR(255)",
            "phone": "VARCHAR(50)",
            "company": "VARCHAR(255)",
            "status": "ENUM('lead','prospect','customer','churned') DEFAULT 'lead'",
            "notes": "TEXT",
            "created_at": "TIMESTAMPTZ DEFAULT now()",
            "updated_at": "TIMESTAMPTZ DEFAULT now()"
          },
          "indexes": [
            "owner_id",
            "status",
            "company"
          ],
          "rls_policy": "sales_rep sees only WHERE owner_id = current_user_id"
        },
        "deals": {
          "columns": {
            "id": "UUID PK DEFAULT gen_random_uuid()",
            "contact_id": "UUID FK→contacts.id",
            "owner_id": "UUID FK→users.id",
            "stage": "ENUM('discovery','proposal','negotiation','closed_won','closed_lost')",
            "value": "DECIMAL(12,2)",
            "expected_close": "DATE",
            "created_at": "TIMESTAMPTZ DEFAULT now()"
          },
          "indexes": [
            "owner_id",
            "contact_id",
            "stage"
          ]
        },
        "subscriptions": {
          "columns": {
            "id": "UUID PK DEFAULT gen_random_uuid()",
            "user_id": "UUID FK→users.id UNIQUE",
            "stripe_customer_id": "TEXT",
            "stripe_subscription_id": "TEXT",
            "plan": "ENUM('free','premium')",
            "status": "ENUM('active','canceled','past_due')",
            "current_period_end": "TIMESTAMPTZ"
          },
          "indexes": [
            "user_id",
            "stripe_subscription_id"
          ]
        },
        "analytics_events": {
          "columns": {
            "id": "UUID PK DEFAULT gen_random_uuid()",
            "user_id": "UUID FK→users.id",
            "event_type": "VARCHAR(100)",
            "entity_type": "VARCHAR(50)",
            "entity_id": "UUID",
            "metadata": "JSONB",
            "occurred_at": "TIMESTAMPTZ DEFAULT now()"
          },
          "indexes": [
            "user_id",
            "event_type",
            "occurred_at"
          ],
          "note": "append-only event store; never update/delete"
        },
        "refresh_tokens": {
          "columns": {
            "id": "UUID PK DEFAULT gen_random_uuid()",
            "user_id": "UUID FK→users.id",
            "token_hash": "TEXT NOT NULL",
            "expires_at": "TIMESTAMPTZ NOT NULL",
            "revoked": "BOOLEAN DEFAULT false"
          },
          "indexes": [
            "token_hash",
            "user_id"
          ]
        }
      },
      "views": {
        "mrr_view": "SELECT DATE_TRUNC('month', current_period_end) AS month, COUNT(*)*29 AS mrr FROM subscriptions WHERE plan='premium' AND status='active' GROUP BY 1",
        "funnel_view": "SELECT stage, COUNT(*) AS count FROM deals GROUP BY stage ORDER BY ARRAY_POSITION(ARRAY['discovery','proposal','negotiation','closed_won','closed_lost'],stage)"
      }
    },
    "auth": {
      "strategy": "JWT + Refresh Token Rotation",
      "access_token": {
        "algorithm": "RS256",
        "expiry": "15m",
        "claims": [
          "sub",
          "role",
          "plan",
          "iat",
          "exp"
        ]
      },
      "refresh_token": {
        "storage": "DB (hashed)",
        "expiry": "30d",
        "rotation": "on_each_use",
        "revocation": "supported"
      },
      "password_policy": {
        "hashing": "bcrypt rounds=12",
        "min_length": 8,
        "require_mixed_case": true,
        "require_number": true
      },
      "rbac_enforcement": "middleware per route; checked before handler executes",
      "row_level_security": "PostgreSQL RLS enabled on contacts, deals tables",
      "oauth_ready": true,
      "mfa_ready": true,
      "rate_limiting": {
        "login_attempts": 5,
        "window": "15m",
        "action": "lockout + notify"
      }
    }
  },
  "business_logic": {
    "plan_gates": {
      "free": {
        "contacts_limit": 250,
        "deals_limit": 50,
        "analytics_access": false,
        "export_access": false,
        "api_access": false
      },
      "premium": {
        "contacts_limit": "unlimited",
        "deals_limit": "unlimited",
        "analytics_access": true,
        "export_access": true,
        "api_access": true
      }
    },
    "payment_lifecycle": [
      {
        "event": "checkout.session.completed",
        "action": "set subscription active; set user.plan=premium"
      },
      {
        "event": "invoice.payment_succeeded",
        "action": "extend current_period_end"
      },
      {
        "event": "invoice.payment_failed",
        "action": "set status=past_due; send dunning email via SendGrid"
      },
      {
        "event": "customer.subscription.deleted",
        "action": "set status=canceled; set user.plan=free; revoke premium features"
      }
    ],
    "contact_ownership": "sales_rep can only CRUD own contacts; manager can reassign; admin can CRUD all",
    "analytics_visibility": "analytics pages and endpoints gated to admin role; manager gets team-level summary only",
    "activity_logging": "every contact/deal mutation emits an analytics_event; used for funnel, heatmap, and audit trail"
  },
